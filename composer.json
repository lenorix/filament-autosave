{
    "name": "lenorix/filament-autosave",
    "description": "Save Filament forms automatically, with a live status indicator, undo support, and local drafts",
    "keywords": ["filament", "autosave", "laravel", "forms", "livewire"],
    "license": "Unlicense",
    "homepage": "https://github.com/lenorix/filament-autosave",
    "support": {
        "issues": "https://github.com/lenorix/filament-autosave/issues",
        "source": "https://github.com/lenorix/filament-autosave"
    },
    "authors": [
        {
            "name": "Lenorix",
            "email": "contact@lenorix.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.93.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.7.8 || ^5.1.4",
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.2",
        "filament/spatie-laravel-media-library-plugin": "^4.0 || ^5.0",
        "lara-zeus/spatie-translatable": "^1.0 || ^2.0",
        "pestphp/pest-plugin-browser": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Lenorix\\FilamentAutosave\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lenorix\\FilamentAutosave\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lenorix\\FilamentAutosave\\AutosaveServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --exclude-testsuite Browser",
        "test:browser": "vendor/bin/pest --testsuite Browser"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
