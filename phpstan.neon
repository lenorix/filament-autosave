includes:
    - phpstan-baseline.neon

parameters:
    # Scope is src/ (plus the analysis-only hosts below, which pull every
    # trait's body into scope). Fixtures and the Unit/Integration/Browser
    # suites are not analysed: "phpstan clean" is a claim about the package
    # itself, not the test tree.
    paths:
        - src
        # Analysis-only hosts that `use` each trait so trait bodies are analysed.
        - tests/Support/Phpstan
    level: 6
    ignoreErrors:
        # The traits are generic over their host (Edit page, Create page, plain
        # Livewire component) and over which Filament/Laravel minor a consumer
        # has installed. Analysed inside one concrete host on one concrete
        # dependency set, every `method_exists($this, …)` / `$this instanceof
        # …` guard for an optional host feature or a method that only exists
        # from a later Filament/Laravel release reads as always-true or
        # always-false there, even though it is not across the version range
        # this package supports; the guards are the point, so the narrowing
        # reports are not defects. PHPStan attributes a trait-body error to
        # whichever file it was analysing when it found it: the trait's own
        # file for a plain boolean check, but the *host* file
        # (tests/Support/Phpstan/*.php) for one that needs the host's type to
        # resolve, such as a call through `$this`. Both paths must be listed
        # or the exact set of matches shifts under a different Filament
        # version and either leaves a real error unignored or an ignore rule
        # unmatched (phpstan.neon's default reportUnmatchedIgnoredErrors also
        # then fails the build) — this is what broke the PHP 8.4 / Filament
        # ^4.0 (prefer-lowest) / Testbench ^10.0 CI cell.
        -
            identifiers:
                - function.alreadyNarrowedType
                - function.impossibleType
                - booleanNot.alwaysFalse
                - booleanAnd.leftAlwaysTrue
                - notIdentical.alwaysTrue
                - nullsafe.neverNull
            paths:
                - src/HasAutosave*.php
                - tests/Support/Phpstan/*.php
            # Which identifier fires, and whether it attributes to the trait
            # file or the host file, depends on the installed Filament/
            # Laravel version: never all of them at once. Requiring every
            # combination to match is what actually broke CI here.
            reportUnmatched: false
        # Filament's transaction helpers exist only on panel pages; the trait
        # calls them behind `autosavePanelOwnsDatabaseTransactions()`.
        -
            message: '#Call to an undefined method .*::(begin|commit|rollBack)DatabaseTransaction\(\)#'
            path: src/HasAutosaveBase.php
